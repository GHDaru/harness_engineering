# chat-companion backend — exemplo de configuração.
# Copie para .env (gitignored) e preencha. NUNCA comite .env com chave real.

# --- LLM ---
# echo = sem rede (testes/estudo do fluxo); openai = qualquer API OpenAI-compatible.
LLM_ADAPTER=openai
# Endpoint gratuito recomendado (NVIDIA NIM). Gere a chave em https://build.nvidia.com
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_API_KEY=nvapi-COLE_A_SUA_CHAVE_AQUI
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# --- Persistência (Neon Postgres) ---
# Connection string do Neon (Dashboard -> Connection Details -> psql/URI).
# Vazio => store em memória (dev). Neon exige SSL (sslmode=require é adicionado se faltar).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# --- Rede ---
# Origens permitidas (CORS), separadas por vírgula. Inclua o site publicado.
ALLOWED_ORIGINS=https://ghdaru.github.io,http://localhost:8000,http://127.0.0.1:8000

# --- Limites ---
RATE_LIMIT_MSGS=20
RATE_LIMIT_WINDOW_S=300
ALLOW_BYOK=true

# --- Sugestões dos leitores (E05) ---
# Destino do email de sugestões (default: ghdaru@gmail.com)
SUGGESTION_EMAIL_TO=ghdaru@gmail.com
# SMTP opcional (vazio = só persiste no banco; leia via GET /suggestions?token=ADMIN_TOKEN)
# Gmail: smtp.gmail.com:587 com App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Token para ler as sugestões via GET /suggestions?token=... (vazio = rota desabilitada)
ADMIN_TOKEN=
