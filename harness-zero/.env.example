# harness-zero — configuração de exemplo.
# Copie para .env e preencha. NUNCA comite a .env com chave real (está no .gitignore).

# Adapter: "echo" (sem rede, para estudar o fluxo) ou "openai" (qualquer API OpenAI-compatible)
LLM_ADAPTER=openai

# --- Opção gratuita recomendada para acompanhar o livro: NVIDIA NIM ---
# Gere sua chave em https://build.nvidia.com (rótulo Agent / Function Calling)
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_API_KEY=nvapi-COLE_A_SUA_CHAVE_AQUI
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# --- Alternativas (descomente a que usar) ---
# OpenAI:        OPENAI_BASE_URL=https://api.openai.com/v1        LLM_MODEL=gpt-5.4-mini
# OpenRouter:    OPENAI_BASE_URL=https://openrouter.ai/api/v1     LLM_MODEL=...
# Ollama local:  OPENAI_BASE_URL=http://localhost:11434/v1        LLM_MODEL=llama3.1   (OPENAI_API_KEY=ollama)
